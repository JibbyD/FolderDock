<!--
  App.xaml — the application definition. Pairs with App.xaml.cs.

  x:Class                  ties this to the App class in App.xaml.cs.
  ShutdownMode=OnMainWindowClose
                           the app exits when the first window shown closes
                           (so closing the popup ends the process).

  There's no StartupUri here on purpose — App.xaml.cs decides in code whether to
  show a window at all (it might just file away dropped shortcuts and quit).
-->
<Application x:Class="FolderDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
</Application>
