<Window x:Class="MyAppsFolder.MainWindow"
        x:Name="Root"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="My Apps"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality">

    <Grid x:Name="RootGrid" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">

        <!-- No full-screen dim and no blur: the live desktop wallpaper shows
             straight through. Only the panel itself carries a light tint. -->

        <StackPanel x:Name="PopupGroup"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Opacity="0"
                    RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <ScaleTransform x:Name="PopupScale" ScaleX="0.6" ScaleY="0.6"/>
            </StackPanel.RenderTransform>

            <!-- Tab bar: one pill per folder, plus the folder + close buttons -->
            <Border Background="#66000000"
                    CornerRadius="22"
                    Padding="8,5"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,16"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal">
                    <ItemsControl x:Name="TabBar">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding TabBackground}"
                                        CornerRadius="15"
                                        Padding="14,6"
                                        Margin="3,0"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="Tab_Down"
                                        MouseLeftButtonUp="Tab_Up">
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{Binding TabForeground}"
                                               FontSize="13"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="&#xE838;"
                               FontFamily="Segoe MDL2 Assets"
                               ToolTip="Open this folder to add or remove apps"
                               Foreground="#CCFFFFFF"
                               FontSize="13"
                               Margin="14,0,2,0"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               MouseLeftButtonDown="OpenFolder_MouseLeftButtonDown"/>
                    <TextBlock Text="&#x2715;"
                               Foreground="#CCFFFFFF"
                               FontSize="13"
                               Margin="10,0,10,0"
                               VerticalAlignment="Center"
                               Cursor="Hand"
                               MouseLeftButtonDown="CloseButton_MouseLeftButtonDown"/>
                </StackPanel>
            </Border>

            <!-- Fixed-height area: keeps the pills above from moving when the
                 panel inside grows or shrinks to fit the selected folder. -->
            <Grid x:Name="CardArea">

            <!-- Shadow layer: a DropShadowEffect rasterises whatever it's on, so
                 it lives on its own empty rounded rectangle. Putting it on the
                 Card itself would blur every icon and label inside it. -->
            <Border VerticalAlignment="Top"
                    Width="{Binding ActualWidth, ElementName=Card}"
                    Height="{Binding ActualHeight, ElementName=Card}"
                    Background="#22000000"
                    CornerRadius="24">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="45" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
            </Border>

            <!-- The panel: light tint over the wallpaper, faint glass edge. No
                 Effect here - keeps text and icons razor sharp. -->
            <Border x:Name="Card"
                    VerticalAlignment="Top"
                    Background="#33000000"
                    BorderBrush="#26FFFFFF"
                    BorderThickness="1"
                    CornerRadius="24"
                    Padding="30"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown">

                <ScrollViewer x:Name="GridScroller"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="AppsGrid"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns, ElementName=Root}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="{Binding TileWidth, ElementName=Root}"
                                            Margin="11,10"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            MouseLeftButtonDown="AppIcon_Down"
                                            MouseLeftButtonUp="AppIcon_Up">
                                    <Border Width="{Binding IconSize, ElementName=Root}"
                                            Height="{Binding IconSize, ElementName=Root}"
                                            CornerRadius="16"
                                            Background="{Binding TileBackground}"
                                            HorizontalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding FallbackText}"
                                                       Visibility="{Binding FallbackVisibility}"
                                                       Foreground="White"
                                                       FontSize="{Binding FallbackFontSize, ElementName=Root}"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            <Image Source="{Binding Icon}"
                                                   Visibility="{Binding IconVisibility}"
                                                   Width="{Binding IconSize, ElementName=Root}"
                                                   Height="{Binding IconSize, ElementName=Root}"
                                                   Stretch="Uniform"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>
                                    <!-- Crisp label: a hard 1px dark copy behind
                                         the white text for legibility over any
                                         wallpaper, without a blurring Effect. -->
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="#B3000000"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="1,1,0,0"/>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   Foreground="White"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
